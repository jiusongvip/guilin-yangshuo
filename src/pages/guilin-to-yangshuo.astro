<DetailLayout title="Guilin to Yangshuo Transport" subtitle="Every way to get between Guilin and Yangshuo, with prices, times, and which one to pick." description="Every way to get from Guilin to Yangshuo: Li River cruise, bus, train, taxi, and private transfer — with 2026 prices, travel times, and which one to pick.">
  <h2>The 4 Ways to Get from Guilin to Yangshuo</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm border border-stone-200 rounded-xl overflow-hidden">
      <thead class="bg-stone-50 text-xs font-semibold uppercase tracking-wider text-stone-400">
