      </thead>
      <tbody class="divide-y divide-stone-100">
        <tr><td class="px-4 py-3 font-medium text-stone-700">Li River Cruise</td><td class="px-4 py-3">4 hours</td><td class="px-4 py-3">~360 RMB</td><td class="px-4 py-3 text-stone-600">The scenic experience</td></tr>
        <tr class="bg-stone-50/50"><td class="px-4 py-3 font-medium text-stone-700">Direct Bus</td><td class="px-4 py-3">1-1.5 hours</td><td class="px-4 py-3">~25 RMB</td><td class="px-4 py-3 text-stone-600">Budget, speed</td></tr>
        <tr><td class="px-4 py-3 font-medium text-stone-700">Taxi / Didi</td><td class="px-4 py-3">1-1.5 hours</td><td class="px-4 py-3">~150-200 RMB</td><td class="px-4 py-3 text-stone-600">Comfort, door-to-door</td></tr>
