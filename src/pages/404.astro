---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found — Guilin Yangshuo Travel Guide" description="The page you're looking for doesn't exist. Find what you need with our travel guides." noIndex noFollow>
  <div class="flex min-h-[60dvh] items-center justify-center px-6 py-24">
    <div class="max-w-md text-center">
      <p class="text-8xl font-bold tracking-tighter text-stone-200">404</p>
      <h1 class="mt-4 text-2xl font-bold text-stone-900">Page not found</h1>
      <p class="mt-3 text-stone-500 leading-relaxed">
        The page you're looking for doesn't exist or has moved. Here are some places to go instead:
      </p>
      <div class="mt-8 grid gap-3 text-left">
        <a href="/" class="rounded-xl border border-stone-200 bg-white p-4 transition-shadow hover:shadow-md">
          <span class="text-sm font-semibold text-stone-900">Homepage</span>
          <span class="block mt-1 text-xs text-stone-400">Start from the beginning</span>
        </a>
        <a href="/yangshuo-travel-guide" class="rounded-xl border border-stone-200 bg-white p-4 transition-shadow hover:shadow-md">
          <span class="text-sm font-semibold text-stone-900">Yangshuo Guide</span>
          <span class="block mt-1 text-xs text-stone-400">Everything about Yangshuo</span>
        </a>
        <a href="/guilin-yangshuo-itinerary-3-day" class="rounded-xl border border-stone-200 bg-white p-4 transition-shadow hover:shadow-md">
          <span class="text-sm font-semibold text-stone-900">3-Day Itinerary</span>
          <span class="block mt-1 text-xs text-stone-400">Ready-to-use trip plan</span>
        </a>
        <a href="/guilin-yangshuo-trip-cost" class="rounded-xl border border-stone-200 bg-white p-4 transition-shadow hover:shadow-md">
          <span class="text-sm font-semibold text-stone-900">Trip Cost Guide</span>
          <span class="block mt-1 text-xs text-stone-400">Real 2026 prices</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
