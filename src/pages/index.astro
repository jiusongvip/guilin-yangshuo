      <a href="/china-internet-vpn" class="group rounded-2xl border border-stone-200 bg-white p-6 transition-shadow hover:shadow-md">
        <h3 class="text-base font-semibold text-stone-900 group-hover:text-accent transition-colors">VPN Setup</h3>
