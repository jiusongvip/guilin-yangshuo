---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import CardLink from "../components/CardLink.astro";
import Map from "../components/Map.astro";
import Faq from "../components/Faq.astro";

const faqItems = [
  { q: "Are Guilin and Yangshuo the same place?", a: "No. Guilin is the city with the airport and train station. Yangshuo is a small town about 65 km south — that's where the iconic karst scenery is. Most people fly into Guilin and head straight to Yangshuo." },
  { q: "How many days do I need?", a: "Three days is the sweet spot: Day 1 — arrive Guilin. Day 2 — Li River cruise to Yangshuo. Day 3 — bike the countryside, hike Moon Hill. Two days works if rushed. Five days lets you add Longji Rice Terraces." },
  { q: "How much does a trip cost?", a: "For 3 days per person: budget $60-150, mid-range $225-435, luxury $720-1,590. Real 2026 prices in USD. China is excellent value — the same scenery experience would cost 3-4x in Europe." },
  { q: "What's the best way to get from Guilin to Yangshuo?", a: "Take the Li River cruise one way (4 hours, ~360 RMB) — it's the experience itself. For the return, use a direct bus (1.5h, 25 RMB) or taxi (1.5h, 150-200 RMB). The cruise only runs Guilin-to-Yangshuo direction." },
  { q: "When should I visit?", a: "April-May and September-October are ideal: pleasant temperatures, clear skies. Avoid October 1-7 (Golden Week) — hotels triple in price. Summer is hot and humid but lush. Winter is quiet and misty — beautiful in a different way." },
  { q: "Do I need a visa for China?", a: "Most visitors need a tourist (L) visa. US citizens pay $140 for a 10-year multiple-entry visa. Some nationalities qualify for 144-hour transit without a visa. Check our visa guide for your specific situation." },
  { q: "Is Yangshuo safe?", a: "Very safe. Violent crime against tourists is extremely rare. Main risks: overpaying for tours, petty scams at transport hubs, getting lost on unmarked rural roads. Common travel sense is all you need." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({ "@type": "Question", "name": item.q, "acceptedAnswer": { "@type": "Answer", "text": item.a } }))
};
---

<Layout title="Guilin & Yangshuo Travel Guide 2026 — Karst Wonderland" description="Plan your Guilin & Yangshuo trip. Honest guide with a 3-day plan, Li River tips, real 2026 costs, and visa advice.">

  <!-- 1. Hero -->
  <section class="relative min-h-screen flex items-center overflow-hidden">
    <img src="/images/hero-li-river.webp" alt="Li River karst mountains at sunrise with bamboo raft" class="absolute inset-0 h-full w-full object-cover" loading="eager" width="1600" height="1100" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/20 via-black/5 to-transparent"></div>
    <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-col items-start justify-between gap-16 px-6 py-32 lg:flex-row lg:items-center lg:py-0">
      <div class="max-w-xl lg:max-w-2xl">
        <span class="inline-block rounded-full border border-white/30 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white mb-6">Independent Travel Guide · 2026</span>
        <h1 class="font-[family-name:var(--font-display)] text-5xl font-bold tracking-tight text-white md:text-7xl lg:text-[7rem] lg:leading-[0.95] drop-shadow-md">Guilin<br/>Yangshuo</h1>
        <p class="mt-6 text-lg leading-relaxed text-white/90 md:text-xl max-w-lg drop-shadow">The landscape that inspired every Chinese painting. Independent advice, real 2026 prices, no fluff.</p>
        <div class="mt-6 flex flex-wrap gap-3 text-sm text-white/80">
          <span class="flex items-center gap-1.5"><i class="fa-regular fa-clock text-white/60"></i> 3-5 days</span>
          <span class="text-white/30">·</span>
          <span class="flex items-center gap-1.5"><i class="fa-solid fa-coins text-white/60"></i> $20-530/day</span>
          <span class="text-white/30">·</span>
          <span class="flex items-center gap-1.5"><i class="fa-regular fa-calendar text-white/60"></i> Best: Apr-May & Sep-Oct</span>
        </div>
      </div>
      <div class="flex shrink-0 flex-col items-center lg:items-end gap-4">
        <a href="/guilin-yangshuo-itinerary-3-day" class="group flex flex-col items-center gap-3 transition-all hover:scale-105">
          <span class="flex h-28 w-28 items-center justify-center rounded-full bg-white text-[#0f766e] shadow-2xl shadow-black/30 transition-all group-hover:shadow-[#0f766e]/30 group-hover:bg-[#ccfbf1]">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
          <span class="text-sm font-semibold text-white drop-shadow-md">Start Planning</span>
        </a>
        <p class="text-xs text-white/50 max-w-[180px] text-center lg:text-right">Jump to the 3-day itinerary</p>
      </div>
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 text-white/50">
      <span class="text-[10px] font-semibold uppercase tracking-[0.2em]">Scroll</span>
      <svg width="16" height="24" viewBox="0 0 16 24" fill="none" stroke="currentColor" stroke-width="1.5" class="animate-bounce"><rect x="1" y="1" width="14" height="22" rx="7"/><circle cx="8" cy="8" r="2" fill="currentColor"/></svg>
    </div>
  </section>

  <!-- 2. Guilin vs Yangshuo -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-fixed bg-cover bg-center" style="background-image: url('/images/bg-guide.webp')"></div>
    <div class="absolute inset-0 bg-white/90"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="tag tag-primary mb-4">First Things First</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-[#1c1a16]">Guilin vs Yangshuo</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-[#5c5a4c]">Two places, 65 km apart. One is the gateway, one is the destination.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 max-w-4xl mx-auto">
        <div class="rounded-2xl border border-[#d5d0c4] bg-white p-8">
          <div class="flex items-center gap-3 mb-5">
            <div class="step-circle step-circle-1">G</div>
            <h3 class="text-2xl font-bold text-[#0f766e]">Guilin</h3>
            <span class="tag tag-primary">Gateway</span>
          </div>
          <p class="text-[#5c5a4c] leading-relaxed">Mid-size city with the airport and train stations. Stay one night — walk the lakes, see Elephant Trunk Hill, eat rice noodles. The next morning, head to Yangshuo.</p>
        </div>
        <div class="rounded-2xl border border-[#d5d0c4] bg-white p-8">
          <div class="flex items-center gap-3 mb-5">
            <div class="step-circle step-circle-3">Y</div>
            <h3 class="text-2xl font-bold text-[#0f766e]">Yangshuo</h3>
            <span class="tag tag-warm">Destination</span>
          </div>
          <p class="text-[#5c5a4c] leading-relaxed">Small town surrounded by karst peaks. This is where the scenery lives — cycling, bamboo rafts, hiking, and waking up to mountains outside your window. Stay 2-4 nights.</p>
        </div>
      </div>
      <Map />
      <div class="mt-6 flex gap-4 text-sm justify-center">
        <a href="/guilin-travel-guide" class="text-[#0f766e] font-semibold hover:underline">Guilin guide</a>
        <span class="text-[#99f6e4]">|</span>
        <a href="/yangshuo-travel-guide" class="text-[#0f766e] font-semibold hover:underline">Yangshuo guide</a>
        <span class="text-[#99f6e4]">|</span>
        <a href="/guilin-to-yangshuo" class="text-[#0f766e] font-semibold hover:underline">How to get between them</a>
      </div>
    </div>
  </section>

  <!-- 3. Your 3-Day Trip -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-fixed bg-cover bg-center" style="background-image: url('/images/bg-about.webp')"></div>
    <div class="absolute inset-0 bg-[#0f766e]/85"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white mb-4">At a Glance</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-white">Your 3-Day Trip</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-white/80">From city to countryside — one unforgettable day at a time.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-2xl bg-white/10 backdrop-blur-sm p-8 border border-white/15 scroll-reveal">
          <div class="step-circle step-circle-1 w-12 h-12 text-lg mb-5">1</div>
          <p class="text-xs font-bold uppercase tracking-wider text-[#5eead4] mb-1">Day 1</p>
          <p class="text-2xl font-bold text-white mb-4">Arrive Guilin</p>
          <p class="text-sm leading-relaxed text-white/75">Fly into KWL. Walk the city lakes. Elephant Trunk Hill. First bowl of rice noodles.</p>
          <a href="/guilin-travel-guide" class="mt-5 inline-flex items-center text-sm font-semibold text-[#5eead4] hover:underline">Guilin guide →</a>
        </div>
        <div class="rounded-2xl bg-white/10 backdrop-blur-sm p-8 border border-white/15 scroll-reveal">
          <div class="step-circle step-circle-2 w-12 h-12 text-lg mb-5">2</div>
          <p class="text-xs font-bold uppercase tracking-wider text-[#99f6e4] mb-1">Day 2</p>
          <p class="text-2xl font-bold text-white mb-4">Li River to Yangshuo</p>
          <p class="text-sm leading-relaxed text-white/75">Li River cruise (4h). Pass the 20 RMB banknote view. Arrive Yangshuo. West Street at night.</p>
          <a href="/li-river-cruise" class="mt-5 inline-flex items-center text-sm font-semibold text-[#99f6e4] hover:underline">Cruise guide →</a>
        </div>
        <div class="rounded-2xl bg-white/10 backdrop-blur-sm p-8 border border-white/15 scroll-reveal">
          <div class="step-circle step-circle-3 w-12 h-12 text-lg mb-5">3</div>
          <p class="text-xs font-bold uppercase tracking-wider text-[#d4a373] mb-1">Day 3</p>
          <p class="text-2xl font-bold text-white mb-4">Countryside by Bike</p>
          <p class="text-sm leading-relaxed text-white/75">Rent a bike. Ten Mile Gallery. Moon Hill hike. Yulong bamboo raft. Cold beer at sunset.</p>
          <a href="/yangshuo-travel-guide" class="mt-5 inline-flex items-center text-sm font-semibold text-[#d4a373] hover:underline">Activities →</a>
        </div>
      </div>
      <div class="mt-10 text-center">
        <a href="/guilin-yangshuo-itinerary-3-day" class="inline-flex items-center gap-2 rounded-full bg-white px-7 py-3.5 text-sm font-bold text-[#0f766e] shadow-lg transition-all hover:shadow-xl hover:scale-105">Full 3-Day Itinerary<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 4l4 4-4 4"/></svg></a>
        <div class="mt-4 flex justify-center gap-4 text-sm"><a href="/guilin-yangshuo-itinerary-2-day" class="text-white/60 hover:text-white transition-colors">2-day</a><span class="text-white/30">|</span><a href="/guilin-yangshuo-itinerary-5-day" class="text-white/60 hover:text-white transition-colors">5-day</a></div>
      </div>
    </div>
  </section>

  <!-- 4. How to Plan -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-fixed bg-cover bg-center" style="background-image: url('/images/bg-plan.webp')"></div>
    <div class="absolute inset-0 bg-white/88"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="tag tag-stone mb-4">Trip Planning</span>
      <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-[#1c1a16]">How to Plan</h2>
      <p class="mt-4 max-w-2xl mx-auto text-lg text-[#5c5a4c]">Four steps. One hour. Done.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/best-time-to-visit-guilin" class="card-playful group rounded-2xl bg-white p-7 shadow-sm border border-[#d5d0c4]/40 scroll-reveal">
          <div class="step-circle step-circle-1 mb-4">1</div>
          <h3 class="text-xl font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Pick dates</h3>
          <p class="mt-2 text-sm text-[#5c5a4c]">Apr–May & Sep–Oct = best. Skip Oct 1–7.</p>
          <span class="mt-4 inline-flex items-center text-sm font-semibold text-[#14b8a6] group-hover:underline">Month-by-month →</span>
        </a>
        <a href="/guilin-yangshuo-itinerary-3-day" class="card-playful group rounded-2xl bg-white p-7 shadow-sm border border-[#d5d0c4]/40 scroll-reveal">
          <div class="step-circle step-circle-2 mb-4">2</div>
          <h3 class="text-xl font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Copy itinerary</h3>
          <p class="mt-2 text-sm text-[#5c5a4c]">Day 1: Guilin. Day 2: cruise. Day 3: bike.</p>
          <span class="mt-4 inline-flex items-center text-sm font-semibold text-[#14b8a6] group-hover:underline">3-day plan →</span>
        </a>
        <a href="/guilin-yangshuo-trip-cost" class="card-playful group rounded-2xl bg-white p-7 shadow-sm border border-[#d5d0c4]/40 scroll-reveal">
          <div class="step-circle step-circle-3 mb-4">3</div>
          <h3 class="text-xl font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Know the cost</h3>
          <p class="mt-2 text-sm text-[#5c5a4c]">Budget $20/day · Mid $75 · Luxury $240+</p>
          <span class="mt-4 inline-flex items-center text-sm font-semibold text-[#14b8a6] group-hover:underline">Full breakdown →</span>
        </a>
        <a href="/china-visa" class="card-playful group rounded-2xl bg-white p-7 shadow-sm border border-[#d5d0c4]/40 scroll-reveal">
          <div class="step-circle step-circle-4 mb-4">4</div>
          <h3 class="text-xl font-bold text-[#1c1a16] group-hover:text-[#0f766e]">Sort logistics</h3>
          <p class="mt-2 text-sm text-[#5c5a4c]">Visa · Alipay · VPN · eSIM. Before you fly.</p>
          <span class="mt-4 inline-flex items-center text-sm font-semibold text-[#14b8a6] group-hover:underline">China prep →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Interactive Tools -->
  <Section>
    <div class="text-center mb-14">
      <span class="tag tag-warm mb-4">Free Tools</span>
      <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-[#1c1a16]">Plan Smarter</h2>
      <p class="mt-4 max-w-2xl mx-auto text-lg text-[#5c5a4c]">No sign-up. No email. Stuff the big platforms don't offer.</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/china-trip-builder" class="card-playful group rounded-2xl bg-white p-8 shadow-sm border border-[#d5d0c4]/40 scroll-reveal">
        <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#dce9ee]/50"><svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[#2dd4bf]"><circle cx="10" cy="5" r="2"/><circle cx="5" cy="15" r="2"/><circle cx="15" cy="15" r="2"/><path d="M9 6.5L6 13.5M10 7l1 3m-1-3l3 7M14 13.5l-1-3"/></svg></div>
        <h3 class="text-xl font-bold text-[#1c1a16] group-hover:text-[#0f766e] transition-colors">China Trip Builder</h3>
        <p class="mt-2 text-sm text-[#5c5a4c]">Pick cities → get a multi-city route with day counts and highlights.</p>
        <span class="mt-4 inline-flex items-center text-sm font-semibold text-[#0f766e] group-hover:underline">Build your route →</span>
      </a>
      <a href="/guilin-trip-cost-calculator" class="card-playful group rounded-2xl bg-white p-8 shadow-sm border border-[#d5d0c4]/40 hover:border-[#d4a373]/30 scroll-reveal">
        <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#fef3c7]/50"><svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[#d4a373]"><rect x="2" y="4" width="16" height="12" rx="2"/><line x1="10" y1="4" x2="10" y2="16"/><line x1="2" y1="9" x2="18" y2="9"/></svg></div>
        <h3 class="text-xl font-bold text-[#1c1a16] group-hover:text-[#0f766e] transition-colors">Cost Calculator</h3>
        <p class="mt-2 text-sm text-[#5c5a4c]">Select style + days → personalized cost estimate in seconds.</p>
        <span class="mt-4 inline-flex items-center text-sm font-semibold text-[#0f766e] group-hover:underline">Calculate →</span>
      </a>
      <a href="/china-packing-list" class="card-playful group rounded-2xl bg-white p-8 shadow-sm border border-[#d5d0c4]/40 hover:border-[#78716c]/30 scroll-reveal">
        <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#edeae3]/50"><svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[#78716c]"><path d="M6 3h8l3 5-7 9-7-9 3-5z"/><line x1="10" y1="3" x2="10" y2="12"/></svg></div>
        <h3 class="text-xl font-bold text-[#1c1a16] group-hover:text-[#0f766e] transition-colors">Packing List</h3>
        <p class="mt-2 text-sm text-[#5c5a4c]">Season + activities → customized checklist.</p>
        <span class="mt-4 inline-flex items-center text-sm font-semibold text-[#0f766e] group-hover:underline">Generate →</span>
      </a>
    </div>
  </Section>

  <!-- 6. Must-Do Experiences -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-fixed bg-cover bg-center" style="background-image: url('/images/bg-experiences.webp')"></div>
    <div class="absolute inset-0 bg-[#0f766e]/88"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="text-center mb-14">
        <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white mb-4">The Highlights</span>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl text-white">Must-Do Experiences</h2>
        <p class="mt-4 max-w-2xl mx-auto text-lg text-white/80">Each has a full guide with prices, best times, and crowd-beating tips.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/li-river-cruise" class="card-playful group block overflow-hidden rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15 scroll-reveal">
          <div class="aspect-[16/10] overflow-hidden"><img src="/images/li-river.webp" alt="Li River Cruise" width="800" height="500" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" decoding="async" /></div>
          <div class="p-5"><h3 class="text-lg font-bold text-white group-hover:text-[#99f6e4]">Li River Cruise</h3><p class="mt-1 text-sm text-white/70">4 hours through China's most dramatic karst scenery.</p></div>
        </a>
        <a href="/yulong-river-bamboo-raft" class="card-playful group block overflow-hidden rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15 scroll-reveal">
          <div class="aspect-[16/10] overflow-hidden"><img src="/images/yulong.webp" alt="Yulong River" width="800" height="500" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" decoding="async" /></div>
          <div class="p-5"><h3 class="text-lg font-bold text-white group-hover:text-[#99f6e4]">Yulong River Raft</h3><p class="mt-1 text-sm text-white/70">Quieter bamboo raft past ancient bridges and water buffalo.</p></div>
        </a>
        <a href="/moon-hill" class="card-playful group block overflow-hidden rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15 scroll-reveal">
          <div class="aspect-[16/10] overflow-hidden"><img src="/images/moon-hill.webp" alt="Moon Hill" width="800" height="500" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" decoding="async" /></div>
          <div class="p-5"><h3 class="text-lg font-bold text-white group-hover:text-[#99f6e4]">Hike Moon Hill</h3><p class="mt-1 text-sm text-white/70">800 steps through a natural stone arch. Best panorama.</p></div>
        </a>
        <a href="/ten-mile-gallery" class="card-playful group block overflow-hidden rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15 scroll-reveal">
          <div class="aspect-[16/10] overflow-hidden"><img src="/images/ten-mile.webp" alt="Ten Mile Gallery" width="800" height="500" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" decoding="async" /></div>
          <div class="p-5"><h3 class="text-lg font-bold text-white group-hover:text-[#99f6e4]">Ten Mile Gallery</h3><p class="mt-1 text-sm text-white/70">The best bike ride in China. 10 km of karst peaks.</p></div>
        </a>
        <a href="/xingping-ancient-town" class="card-playful group block overflow-hidden rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15 scroll-reveal">
          <div class="aspect-[16/10] overflow-hidden"><img src="/images/xingping.webp" alt="Xingping" width="800" height="500" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" decoding="async" /></div>
          <div class="p-5"><h3 class="text-lg font-bold text-white group-hover:text-[#99f6e4]">Xingping Ancient Town</h3><p class="mt-1 text-sm text-white/70">The village on the 20 RMB banknote. Iconic river view.</p></div>
        </a>
        <a href="/longji-rice-terraces" class="card-playful group block overflow-hidden rounded-2xl bg-white/10 backdrop-blur-sm border border-white/15 scroll-reveal">
          <div class="aspect-[16/10] overflow-hidden"><img src="/images/longji.webp" alt="Longji" width="800" height="500" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" decoding="async" /></div>
          <div class="p-5"><h3 class="text-lg font-bold text-white group-hover:text-[#99f6e4]">Longji Rice Terraces</h3><p class="mt-1 text-sm text-white/70">650-year-old terraces. Mirror-like in spring, golden in autumn.</p></div>
        </a>
