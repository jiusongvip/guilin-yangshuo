---
import DetailLayout from "../layouts/DetailLayout.astro";
import TripBuilder from "../components/tools/TripBuilder";
---

<DetailLayout
  title="China Trip Builder"
  subtitle="Pick your cities and get a suggested multi-city route with day counts and highlights."
  description="Free interactive China trip planner. Select cities, get a day-by-day route with highlights. Plan your Beijing, Xi'an, Guilin, Shanghai itinerary."
>
  <p class="mb-8 text-stone-600">Design your China itinerary in under a minute. Pick the cities you want to visit in order — we'll suggest how many days to spend in each and what to see. Guilin Yangshuo fits perfectly as the nature segment between urban stops.</p>
  <TripBuilder client:idle />

  <div class="mt-12 rounded-2xl border border-stone-200 bg-stone-50 p-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-stone-400">Continue Reading</p>
    <ul class="mt-3 space-y-2 text-sm">
      <li><a href="/guilin-in-your-china-trip/" class="text-accent hover:underline">Guilin in Your China Trip</a></li>
      <li><a href="/china-visa/" class="text-accent hover:underline">China Visa Guide</a></li>
      <li><a href="/guilin-to-yangshuo/" class="text-accent hover:underline">Guilin to Yangshuo Transport</a></li>
      <li><a href="/how-to-book-china-trains/" class="text-accent hover:underline">How to Book China Trains</a></li>
    </ul>
  </div>

</DetailLayout>
