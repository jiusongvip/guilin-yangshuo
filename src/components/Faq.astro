---
const { items, jumpLinks = false } = Astro.props;
---
<dl class="space-y-6">
  {items.map((item, i) => (
    <div id={jumpLinks ? `faq-${i}` : undefined} class="scroll-reveal p-6 rounded-xl bg-white border border-[#d5d0c4]/40 shadow-sm hover:shadow-md transition-shadow">
      <dt class="text-lg font-bold text-[#0f766e] flex items-start gap-3">
        <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#14b8a6] to-[#5eead4] text-white text-xs font-bold">?</span>
        {item.q}
      </dt>
      <dd class="mt-3 text-[#5c5a4c] leading-relaxed pl-10">{item.a}</dd>
    </div>
  ))}
</dl>
