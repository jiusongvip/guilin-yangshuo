---
const { class: className = "" } = Astro.props;
---
<div class={`mt-8 overflow-hidden rounded-2xl border border-[#d5d0c4] shadow-sm ${className}`} style="height: 420px;">
  <div id="guilin-map" role="img" aria-label="Interactive map of Guilin, Yangshuo, and the Li River cruise route" style="width: 100%; height: 100%;"></div>
</div>
<script>
  (function () {
    const container = document.getElementById('guilin-map');
    if (!container) return;
    const start = () => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = '1';
      if (typeof L === 'undefined') {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        css.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
        css.crossOrigin = '';
        document.head.appendChild(css);
        const script = document.createElement('script');
        script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
        script.crossOrigin = '';
        script.onload = initMap;
        document.head.appendChild(script);
      } else { initMap(); }
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some(e => e.isIntersecting)) { io.disconnect(); start(); }
      }, { rootMargin: '300px' });
      io.observe(container);
    } else { start(); }

    function initMap() {
      if (!container || container.dataset.ready) return;
      container.dataset.ready = '1';
      const map = L.map('guilin-map', { center: [25.05, 110.35], zoom: 10, scrollWheelZoom: false, zoomControl: true });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>', maxZoom: 18 }).addTo(map);

      const guilinIcon = L.divIcon({
        className: 'map-marker-city',
        html: '<div role="img" aria-label="Guilin" style="background:#0f766e;color:#fff;padding:4px 12px;border-radius:10px;font-size:12px;font-weight:700;white-space:nowrap;box-shadow:0 2px 8px rgba(26,58,74,0.3);border:2px solid #fff;"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V8l5-4v17"/><path d="M10 10h9v11"/><path d="M14 14h1m3 0h1m-5 4h1m3 0h1"/></svg>Guilin</div>',
        iconAnchor: [30, 14],
      });
      L.marker([25.273, 110.290], { icon: guilinIcon, keyboard: false, title: 'Guilin City', alt: 'Guilin City' }).addTo(map).bindPopup('<b>Guilin City</b><br>Train stations, hotels, city lakes');

      const airportIcon = L.divIcon({
        className: 'map-marker-airport',
        html: '<div role="img" aria-label="Guilin Liangjiang Airport KWL" style="display:flex;align-items:center;gap:4px;background:#5eead4;color:#fff;padding:4px 10px;border-radius:10px;font-size:11px;font-weight:700;white-space:nowrap;box-shadow:0 2px 8px rgba(91,138,154,0.3);border:2px solid #fff;"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg> KWL</div>',
        iconAnchor: [25, 14],
      });
      L.marker([25.218, 110.039], { icon: airportIcon, keyboard: false, title: 'Guilin Liangjiang Airport (KWL)', alt: 'Guilin Liangjiang Airport' }).addTo(map).bindPopup('<b>Guilin Liangjiang Airport (KWL)</b><br>30 km from Guilin city center');

      const xingpingIcon = L.divIcon({
        className: 'map-marker-viewpoint',
        html: '<div role="img" aria-label="Xingping viewpoint" style="background:#d4a373;color:#fff;padding:4px 10px;border-radius:10px;font-size:11px;font-weight:700;white-space:nowrap;box-shadow:0 2px 8px rgba(196,168,130,0.3);border:2px solid #fff;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></div>',
        iconAnchor: [12, 6],
      });
      L.marker([24.920, 110.528], { icon: xingpingIcon, keyboard: false, title: 'Xingping', alt: 'Xingping 20 RMB note viewpoint' }).addTo(map).bindPopup('<b>Xingping</b><br>20 RMB note viewpoint');

      const yangshuoIcon = L.divIcon({
        className: 'map-marker-city',
        html: '<div role="img" aria-label="Yangshuo" style="background:#5eead4;color:#fff;padding:4px 12px;border-radius:10px;font-size:12px;font-weight:700;white-space:nowrap;box-shadow:0 2px 8px rgba(91,138,154,0.3);border:2px solid #fff;"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px" aria-hidden="true"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>Yangshuo</div>',
        iconAnchor: [36, 14],
      });
      L.marker([24.778, 110.497], { icon: yangshuoIcon, keyboard: false, title: 'Yangshuo', alt: 'Yangshuo' }).addTo(map).bindPopup('<b>Yangshuo</b><br>Karst peaks, West Street');

      const riverRoute = [[25.273,110.290],[25.240,110.340],[25.200,110.390],[25.150,110.430],[25.110,110.460],[25.060,110.490],[25.000,110.510],[24.960,110.520],[24.920,110.528],[24.880,110.515],[24.830,110.502],[24.778,110.497]];
      L.polyline(riverRoute, { color: '#5eead4', weight: 3, opacity: 0.5, dashArray: '8 4' }).addTo(map).bindPopup('<b>Li River Cruise Route</b><br>~83 km · ~4 hours');
      L.polyline([[25.273,110.290],[24.778,110.497]], { color: '#d4a373', weight: 2, opacity: 0.5, dashArray: '6 6' }).addTo(map).bindPopup('<b>Direct road distance</b><br>~65 km · ~1.5 hours by car');
      setTimeout(() => map.invalidateSize(), 100);
    }
  })();
</script>
<style is:global>
  #guilin-map { background: #edeae3; }
  .map-marker-city, .map-marker-airport, .map-marker-viewpoint { background: none !important; border: none !important; }
</style>
