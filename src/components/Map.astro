---
const { class: className = "" } = Astro.props;
---
<div class={`mt-8 overflow-hidden rounded-2xl border border-stone-200 bg-stone-100 ${className}`} style="height: 420px;">
  <div id="guilin-map" style="width: 100%; height: 100%;"></div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin="" />

<script>
  (function () {
    if (typeof L === 'undefined') {
      const script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
      script.crossOrigin = '';
      script.onload = initMap;
      document.head.appendChild(script);
    } else {
      initMap();
    }

    function initMap() {
      const container = document.getElementById('guilin-map');
      if (!container || container.dataset.initialized) return;
      container.dataset.initialized = '1';

      // Center map between Guilin and Yangshuo
      const map = L.map('guilin-map', {
        center: [25.05, 110.35],
        zoom: 10,
        scrollWheelZoom: false,
        zoomControl: true,
      });

      // OpenStreetMap tiles (free, no API key)
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 18,
      }).addTo(map);

      // --- Markers ---

      // Guilin City Center
      const guilinIcon = L.divIcon({
        className: 'map-marker-city',
        html: '<div style="background:#d97706;color:#fff;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:600;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,0.25);border:2px solid #fff;">Guilin</div>',
        iconAnchor: [30, 14],
      });

      L.marker([25.273, 110.290], { icon: guilinIcon }).addTo(map)
        .bindPopup('<b>Guilin City</b><br>Train stations, hotels, city lakes');

      // Guilin Airport KWL
      const airportIcon = L.divIcon({
        className: 'map-marker-airport',
        html: '<div style="display:flex;align-items:center;gap:4px;background:#475569;color:#fff;padding:4px 10px;border-radius:8px;font-size:11px;font-weight:600;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,0.25);border:2px solid #fff;">✈ KWL</div>',
        iconAnchor: [25, 14],
      });

      L.marker([25.218, 110.039], { icon: airportIcon }).addTo(map)
        .bindPopup('<b>Guilin Liangjiang Airport (KWL)</b><br>30 km from Guilin city center');

      // Xingping (20 RMB viewpoint)
      const xingpingIcon = L.divIcon({
        className: 'map-marker-viewpoint',
        html: '<div style="background:#059669;color:#fff;padding:3px 8px;border-radius:6px;font-size:10px;font-weight:600;white-space:nowrap;box-shadow:0 1px 4px rgba(0,0,0,0.25);border:2px solid #fff;">📍</div>',
        iconAnchor: [12, 6],
      });

      L.marker([24.920, 110.528], { icon: xingpingIcon }).addTo(map)
        .bindPopup('<b>Xingping</b><br>20 RMB note viewpoint<br>Ancient town');

      // Yangshuo
      const yangshuoIcon = L.divIcon({
        className: 'map-marker-city',
        html: '<div style="background:#d97706;color:#fff;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:600;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,0.25);border:2px solid #fff;">Yangshuo</div>',
        iconAnchor: [36, 14],
      });

      L.marker([24.778, 110.497], { icon: yangshuoIcon }).addTo(map)
        .bindPopup('<b>Yangshuo</b><br>Karst peaks, West Street, countryside');

      // --- Li River route (approximate path) ---
      const riverRoute = [
        [25.273, 110.290], // Guilin
        [25.240, 110.340],
        [25.200, 110.390],
        [25.150, 110.430],
        [25.110, 110.460],
        [25.060, 110.490],
        [25.000, 110.510],
        [24.960, 110.520],
        [24.920, 110.528], // Xingping
        [24.880, 110.515],
        [24.830, 110.502],
        [24.778, 110.497], // Yangshuo
      ];

      L.polyline(riverRoute, {
        color: '#0ea5e9',
        weight: 3,
        opacity: 0.7,
        dashArray: '8 4',
      }).addTo(map).bindPopup('<b>Li River Cruise Route</b><br>~83 km · ~4 hours');

      // --- Distance line (Guilin to Yangshuo direct) ---
      L.polyline([[25.273, 110.290], [24.778, 110.497]], {
        color: '#d97706',
        weight: 2,
        opacity: 0.4,
        dashArray: '6 6',
      }).addTo(map).bindPopup('<b>Direct road distance</b><br>~65 km · ~1.5 hours by car');

      // Invalidate size after init (handles any layout shifts)
      setTimeout(() => map.invalidateSize(), 100);
    }
  })();
</script>

<style is:global>
  #guilin-map {
    background: #f5f5f4;
  }
  .map-marker-city,
  .map-marker-airport,
  .map-marker-viewpoint {
    background: none !important;
    border: none !important;
  }
</style>
