---
const { href, image, title, description, color = "default" } = Astro.props;
const accentBorderClass = color === "warm" ? "hover:border-[#d4a373]/40" :
  color === "stone" ? "hover:border-[#a8a29e]/40" : "hover:border-[#99f6e4]/30";
---
<a href={href} class={`card-playful group block overflow-hidden rounded-2xl bg-white border border-[#d5d0c4]/40 shadow-sm ${accentBorderClass}`}>
  <div class="aspect-[16/10] overflow-hidden bg-[#edeae3]">
    <img
      src={image} alt={title} width="800" height="500"
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
      loading="lazy" decoding="async"
    />
  </div>
  <div class="p-6">
    <h3 class="text-lg font-bold text-[#1c1a16] group-hover:text-[#0f766e] transition-colors">{title}</h3>
    {description && <p class="mt-1.5 text-sm leading-relaxed text-[#5c5a4c]">{description}</p>}
  </div>
</a>
