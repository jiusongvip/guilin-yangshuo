---
const { text, author, role } = Astro.props;
---
<blockquote class="relative border-l-4 border-[#99f6e4]/40 bg-gradient-to-r from-[#ccfbf1]/12 to-transparent px-8 py-6 rounded-r-xl scroll-reveal">
  <svg class="absolute top-4 left-4 text-[#99f6e4]/20" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z"/></svg>
  <p class="text-lg leading-relaxed text-[#1c1a16] pl-6">{text}</p>
  <footer class="mt-4 text-sm text-[#5c5a4c] pl-6">
    <cite class="not-italic font-semibold text-[#0f766e]">{author}</cite>
    {role && <span class="text-[#5c5a4c]">, {role}</span>}
  </footer>
</blockquote>
