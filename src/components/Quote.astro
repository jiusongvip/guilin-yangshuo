---
const { text, author, role } = Astro.props;
---
<blockquote class="border-l-4 border-accent/30 bg-stone-100/80 px-6 py-5 rounded-r-xl">
  <p class="text-lg leading-relaxed text-stone-700">{text}</p>
  <footer class="mt-3 text-sm text-stone-500">
    <cite class="not-italic font-medium text-stone-700">{author}</cite>
    {role && <span class="text-stone-400">, {role}</span>}
  </footer>
</blockquote>
