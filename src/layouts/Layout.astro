---
import "../styles/global.css";
import { SITE, NAV } from "../consts";

interface Props {
  ogImage?: string;
  title?: string;
  description?: string;
  noIndex?: boolean;
  noFollow?: boolean;
  image?: string;
}

const title = Astro.props.title ?? SITE.title;
const description = Astro.props.description ?? SITE.description;
const ogImage = Astro.props.ogImage ?? (Astro.props.image ? new URL(Astro.props.image, SITE.url).href : new URL('/images/hero-li-river.webp', SITE.url).href);
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const noIndex = Astro.props.noIndex ?? false;
const noFollow = Astro.props.noFollow ?? false;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noIndex && <link rel="canonical" href={canonical} />}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/Geist-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {!noIndex && <link rel="alternate" hreflang="en" href={canonical} />}
    {!noIndex && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta name="keywords" content="Guilin travel guide, Yangshuo travel guide, Guilin Yangshuo itinerary, Li River cruise, China travel tips, Guilin things to do, Yangshuo hotels, Guilin to Yangshuo" />
    {(noIndex || noFollow) && <meta name="robots" content={`${noIndex ? 'noindex' : ''}, ${noFollow ? 'nofollow' : ''}`} />}
    {path === '/' ? <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Guilin & Yangshuo Travel Guide",
      "url": "https://guilin-yangshuo.com",
      "description": "Independent, honest travel guide for Guilin and Yangshuo. Itineraries, costs, visa advice, and local tips — no tour sales, no fluff.",
      "inLanguage": "en"
    }
    </script> : false}
    {Astro.props.image && <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ImageObject",
      "url": new URL(Astro.props.image, SITE.url).href,
      "caption": Astro.props.title ?? SITE.title,
      "width": "1200"
    })}></script>}
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const btn = document.getElementById("mobile-menu-btn");
        const menu = document.getElementById("mobile-menu");
        if (btn && menu) {
          btn.addEventListener("click", () => {
            const open = menu.classList.toggle("hidden");
            btn.setAttribute("aria-expanded", String(!open));
          });
          document.addEventListener("click", (e) => {
            if (!btn.contains(e.target) && !menu.contains(e.target)) {
              menu.classList.add("hidden");
              btn.setAttribute("aria-expanded", "false");
            }
          });
        }
      });
    </script>
  </head>
  <body class="min-h-dvh bg-stone-50 text-stone-900 antialiased">
    <header class="sticky top-0 z-50 border-b border-stone-200/80 bg-stone-50/90 backdrop-blur-md">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
        <a href="/" class="text-lg font-semibold tracking-tight text-accent">Guilin Yangshuo</a>
        <ul class="hidden items-center gap-8 text-sm font-medium md:flex">
          {NAV.map((item) => (
            <li><a href={item.href} class="text-stone-600 transition-colors hover:text-stone-900">{item.label}</a></li>
          ))}
          <li><a href="/about" class="text-stone-500 transition-colors hover:text-stone-700">About</a></li>
        </ul>
        <button id="mobile-menu-btn" class="md:hidden text-stone-700" aria-label="Toggle menu" aria-expanded="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </nav>
      <!-- Mobile menu panel -->
      <div id="mobile-menu" class="hidden border-t border-stone-200 bg-stone-50 px-6 py-4 md:hidden">
        <ul class="space-y-3 text-sm font-medium">
          {NAV.map((item) => (
            <li><a href={item.href} class="block text-stone-700 hover:text-stone-900">{item.label}</a></li>
          ))}
          <li><a href="/about" class="block text-stone-500 hover:text-stone-700">About</a></li>
          <li class="pt-2 border-t border-stone-200">
            <a href="/china-trip-builder" class="block text-stone-600 hover:text-stone-900">Trip Builder</a>
          </li>
          <li>
            <a href="/guilin-trip-cost-calculator" class="block text-stone-600 hover:text-stone-900">Cost Calculator</a>
          </li>
          <li>
            <a href="/china-packing-list" class="block text-stone-600 hover:text-stone-900">Packing List</a>
          </li>
        </ul>
      </div>
    </header>
    <main><slot /></main>
    <footer class="border-t border-stone-200 bg-stone-50 py-16">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid gap-12 md:grid-cols-4">
          <div>
            <p class="text-sm font-semibold text-accent">Guilin Yangshuo</p>
            <p class="mt-2 max-w-xs text-sm leading-relaxed text-stone-500">Independent travel guide. No tour sales, no sponsored fluff. Just honest advice for your China trip.</p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">Explore</p>
            <ul class="mt-4 space-y-3 text-sm">
              <li><a href="/yangshuo-travel-guide" class="text-stone-500 hover:text-stone-900">Yangshuo Guide</a></li>
              <li><a href="/guilin-travel-guide" class="text-stone-500 hover:text-stone-900">Guilin Guide</a></li>
              <li><a href="/li-river-cruise" class="text-stone-500 hover:text-stone-900">Li River Cruise</a></li>
              <li><a href="/guilin-yangshuo-itinerary-3-day" class="text-stone-500 hover:text-stone-900">3-Day Itinerary</a></li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">Plan</p>
            <ul class="mt-4 space-y-3 text-sm">
              <li><a href="/guilin-yangshuo-trip-cost" class="text-stone-500 hover:text-stone-900">Trip Cost</a></li>
              <li><a href="/china-visa" class="text-stone-500 hover:text-stone-900">China Visa</a></li>
              <li><a href="/best-time-to-visit-guilin" class="text-stone-500 hover:text-stone-900">Best Time to Visit</a></li>
              <li><a href="/guilin-to-yangshuo" class="text-stone-500 hover:text-stone-900">Getting There</a></li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">Essentials</p>
            <ul class="mt-4 space-y-3 text-sm">
              <li><a href="/alipay-wechat-setup" class="text-stone-500 hover:text-stone-900">Mobile Payments</a></li>
              <li><a href="/china-internet-guide" class="text-stone-500 hover:text-stone-900">Internet & eSIM</a></li>
              <li><a href="/survival-chinese-phrases" class="text-stone-500 hover:text-stone-900">Chinese Phrases</a></li>
              <li><a href="/guilin-travel-mistakes" class="text-stone-500 hover:text-stone-900">Mistakes to Avoid</a></li>
              <li><a href="/china-trip-builder" class="text-stone-500 hover:text-stone-900">Trip Builder</a></li>
              <li><a href="/guilin-trip-cost-calculator" class="text-stone-500 hover:text-stone-900">Cost Calculator</a></li>
              <li><a href="/china-packing-list" class="text-stone-500 hover:text-stone-900">Packing List</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 border-t border-stone-200 pt-8 text-center text-xs text-stone-400">
          <p>Independent travel guide. Not affiliated with any tour agency or hotel.</p>
        </div>
      </div>
    </footer>
  </body>
</html>




