---
import Layout from "./Layout.astro";
import { SITE } from "../consts";

export interface Props {
  title: string;
  seoTitle?: string;
  subtitle?: string;
  image?: string;
  description?: string;
}

const { title, subtitle, image, description } = Astro.props;
const seoTitle = Astro.props.seoTitle ?? `${title} - Guilin Yangshuo Guide`;
const canonical = Astro.url.pathname === '/'
  ? new URL('/', SITE.url).href.replace(/\/$/, '')
  : new URL(Astro.url.pathname, SITE.url).href;

function toCrumbName(slug: string): string {
  return slug.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
}

const path = Astro.url.pathname;
const segments = path.replace(/^\/+|\/+$/g, "").split("/");
const crumbs = [
  { label: "Home", href: "/" },
  ...segments.map((seg, i) => ({
    label: toCrumbName(seg),
    href: "/" + segments.slice(0, i + 1).join("/") + "/",
  })),
];
crumbs[crumbs.length - 1].label = title;

const breadcrumbLD = JSON.stringify({
  "@type": "BreadcrumbList",
  "itemListElement": crumbs.map((crumb, i) => ({
    "@type": "ListItem", "position": i + 1, "name": crumb.label, "item": SITE.url + crumb.href,
  })),
});

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description ?? subtitle ?? "",
  "url": canonical,
  "breadcrumb": JSON.parse(breadcrumbLD),
  "about": { "@type": "Place", "name": "Guilin & Yangshuo" },
  "publisher": { "@type": "Organization", "name": "Guilin Yangshuo Travel Guide", "url": SITE.url },
});
---

<Layout title={title} seoTitle={seoTitle} description={description} ogImage={image ? new URL(image, SITE.url).href : undefined} image={image}>
  <script type="application/ld+json" set:html={jsonLd}></script>

  <article class="pt-28 pb-8 md:pt-36 md:pb-14">
    <div class="mx-auto max-w-3xl px-5 sm:px-6">
      <nav class="mb-8 flex flex-wrap items-center gap-1.5 text-sm text-[#5c5a4c]/60" aria-label="Breadcrumb">
        {crumbs.map((crumb, i) => (
          <>
            {i > 0 && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 opacity-40"><path d="M9 18l6-6-6-6"/></svg>}
            {i < crumbs.length - 1 ? (
              <a href={crumb.href} class="transition-colors hover:text-[#0f766e]">{crumb.label}</a>
            ) : (
              <span class="text-[#0f766e] font-medium">{crumb.label}</span>
            )}
          </>
        ))}
      </nav>

      <header class="mb-12 md:mb-16">
        <div class="hero-accent-line mb-6"></div>
        <h1 class="text-3xl font-bold tracking-tight text-[#1c1a16] sm:text-4xl md:text-5xl md:leading-tight">{title}</h1>
        {subtitle && <p class="mt-5 text-lg leading-relaxed text-[#5c5a4c] md:text-xl md:leading-relaxed">{subtitle}</p>}
      </header>

      {image && (
        <div class="mb-12 md:mb-16 relative">
          <div class="aspect-[21/9] overflow-hidden rounded-2xl shadow-lg shadow-[#0f766e]/8">
            <img src={image} alt={title} class="h-full w-full object-cover" width="1200" height="514" loading="eager" decoding="async" />
          </div>
          <div class="organic-blob organic-blob-1 absolute -bottom-8 -right-8 -z-10" style="width:180px;height:180px;"></div>
        </div>
      )}

      <div class="prose prose-stone prose-lg max-w-none scroll-reveal">
        <slot />
      </div>

      <footer class="mt-20 pt-10 border-t border-[#d5d0c4]">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <a href="/" class="group inline-flex items-center gap-2 text-sm font-semibold text-[#0f766e] transition-colors hover:text-[#14b8a6]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover:-translate-x-0.5"><path d="M15 18l-6-6 6-6"/></svg>
            Back to homepage
          </a>
          <p class="text-xs text-[#5c5a4c]/50">Last updated: August 2026</p>
        </div>
      </footer>
    </div>
  </article>
</Layout>
